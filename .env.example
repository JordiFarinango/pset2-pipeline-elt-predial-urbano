# Copiar manualmente a .env. Nunca versionar el archivo real.
# Valores vacios obligatorios: Compose rechazara el inicio hasta completarlos.
POSTGRES_DB=kestra
POSTGRES_USER=kestra
POSTGRES_PASSWORD=

# Ejemplo de correo sin cuenta real; sustituir para el acceso local a Kestra.
KESTRA_ADMIN_EMAIL=admin@example.invalid
KESTRA_ADMIN_PASSWORD=
KESTRA_HTTP_PORT=8080

# Para contrasenas con $, # o espacios, usar comillas simples en .env.
# Elegir dos contrasenas diferentes; no reutilizar credenciales municipales.
# SQL Server, Snowflake y HMAC no se configuran ni se consumen en esta etapa.
# No agregar aqui contrasenas municipales ni la clave HMAC.
